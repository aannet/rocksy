# Artefacts de build des spikes et du futur code
target/
node_modules/
dist/
*.exe
*.pdb
__pycache__/

# Vaults synthétiques générés (peuvent peser plusieurs Go)
vaults/
.rocksy-synth/

# Fichiers locaux
.claude/settings.local.json
.env
*.log

# Captures volumineuses des runs : versionner seulement ce qui est cité dans un rapport
runs/**/*.mp4
runs/**/*.mkv

# Captures du run d'integration (18 Mo de PNG sur donnees synthetiques) : conservees sur disque, non versionnees
runs/*_integration/captures/
runs/*_integration-audits/captures/

# Terms that must never appear in a tracked file (read by tools/check-consistency.py); the owner creates this file
.private-terms
