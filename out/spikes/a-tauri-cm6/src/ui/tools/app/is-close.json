{
 "app": {
  "dataDir": "{IT}\\data-is-close",
  "args": []
 },
 "steps": [
  {
   "wait": "window.rocksyReady",
   "timeout": 20000
  },
  {
   "evalfile": "helpers.js"
  },
  {
   "eval": "(()=>{window.__p=[];window.__TAURI__.event.listen('tags-progress',e=>window.__p.push(e.payload));T.addVault(T.ref('x20'));return 1})()"
  },
  {
   "wait": "window.__p.length>0",
   "timeout": 10000
  },
  {
   "eval": "JSON.stringify({progressAtClose:window.__p[window.__p.length-1], events:rocksy.indexEvents.length})",
   "save": "P7_stateWhenClosing"
  },
  {
   "py": "close",
   "save": "P7_closeMainWindow(ok exited)"
  },
  {
   "py": "alive",
   "save": "P7_aliveAfterClose"
  },
  {
   "py": "listdir",
   "path": "{IT}\\data-is-close",
   "save": "P7_dataDirAfterClose"
  },
  {
   "restart": {
    "args": []
   },
   "save": "relaunchAttachMs"
  },
  {
   "wait": "window.rocksyReady",
   "timeout": 20000
  },
  {
   "eval": "JSON.stringify({vault:rocksy.vaultRoot, tree:!!rocksy.tree})",
   "save": "P7_afterRelaunch_session"
  },
  {
   "evalfile": "helpers.js"
  },
  {
   "eval": "(async()=>{if(!rocksy.vaultRoot){await T.addVault(T.ref('x20'))}return T.wait(()=>rocksy.indexEvents.some(e=>!e.fromCache&&e.searchReady),60000)})()",
   "save": "P7_waitIndexMs"
  },
  {
   "eval": "(async()=>{const r=await T.inv('search',{query:'plan'});return JSON.stringify({events:rocksy.indexEvents.map(e=>({atMs:e.atMs,fromCache:e.fromCache,searchReady:e.searchReady,reread:e.reread,removed:e.removed,files:e.files,searchDocs:e.searchDocs,ms:e.ms})), search:{total:r.total,ready:r.searchReady}, tags:(await T.inv('tags_list',{query:''})).length})})()",
   "save": "P7_afterRelaunch_index"
  },
  {
   "py": "alive",
   "save": "P7_aliveAtEnd"
  },
  {
   "restart": {
    "args": []
   }
  },
  {
   "wait": "window.rocksyReady && rocksy.indexEvents.some(e=>!e.fromCache)",
   "timeout": 30000
  },
  {
   "eval": "JSON.stringify(rocksy.indexEvents.map(e=>({fromCache:e.fromCache,searchReady:e.searchReady,reread:e.reread,files:e.files,searchDocs:e.searchDocs})))",
   "save": "P7_thirdLaunch_index"
  }
 ]
}