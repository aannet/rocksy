{"app":{"dataDir":"{IT}\\data-preview","args":[]},
 "steps":[
 {"wait":"window.rocksyReady","timeout":20000},
 {"evalfile":"helpers.js"},
 {"shot":"it-welcome-empty-profile.png"},
 {"eval":"JSON.stringify({buttons:[...document.querySelectorAll('.empty button')].map(b=>b.textContent), vaults:rocksy.vaults, sidebarHidden:document.getElementById('sidebar').hidden})","save":"welcome"},
 {"eval":"T.addVault(T.it('v1'))","save":"treeEntries"},
 {"wait":"rocksy.tagsInfo","timeout":30000,"save":"tagsReadyWaitMs"},
 {"eval":"JSON.stringify({metrics:rocksy.metrics, tags:rocksy.tagsInfo, vaults:rocksy.vaults, sidebarHidden:document.getElementById('sidebar').hidden, rows:T.count('.tree-row')})","save":"afterAddVault"},
 {"eval":"T.open(T.vault('01_WORK','__DAILY NOTES SYNTH.md')).then(JSON.stringify)","save":"openBig"},
 {"sleep":500},
 {"shot":"it-f1-big-note-top.png"},
 {"eval":"JSON.stringify({line:T.show('**'), hiddenMarks: T.count('.cm-lp-strong'), h:T.count('.cm-lp-h'), tags:T.count('.cm-lp-tag'), checks:T.count('.cm-lp-check'), bullets:T.count('.cm-lp-bullet'), links:T.count('.cm-lp-link'), quotes:T.count('.cm-lp-quote,.cm-lp-callout'), code:T.count('.cm-lp-code')})","save":"f1Counts"},
 {"sleep":400},
 {"shot":"it-f1-big-note-inline.png"},
 {"eval":"JSON.stringify({line:T.cursor('**',0,3), text:T.curLine()})","save":"cursorInBold"},
 {"sleep":250},
 {"shot":"it-f1-cursor-in-bold.png"},
 {"eval":"T.show('![[Pasted image')","save":"embedLine"},
 {"wait":"T.imgs().length>0 && T.imgs().every(i=>i.ok)","timeout":8000,"save":"imagesWaitMs"},
 {"eval":"JSON.stringify(T.imgs().slice(0,6))","save":"f3Images"},
 {"shot":"it-f3-embeds-big-note.png"},
 {"eval":"JSON.stringify({line:T.show('```'), cb:T.count('.cm-lp-cb')})","save":"codeBlock"},
 {"sleep":900},
 {"eval":"JSON.stringify({label:[...document.querySelectorAll('.cm-lp-cb-label')].map(e=>e.textContent), coloredSpans:document.querySelectorAll('.cm-lp-cb span[class]').length})","save":"codeColor"},
 {"shot":"it-f2-code-big-note.png"},
 {"eval":"T.open(T.vault('00_INBOX','Décision plan 00434.md')).then(JSON.stringify)","save":"openNote"},
 {"sleep":400},
 {"shot":"it-f2-frontmatter-note.png"},
 {"eval":"JSON.stringify({line:T.show('\\n|'), tables:T.count('.cm-lp-table')})","save":"table"},
 {"sleep":400},
 {"shot":"it-f2-table.png"},
 {"eval":"JSON.stringify({line:T.cursor('\\n|',0,3), tablesAfterCursor:T.count('.cm-lp-table'), src:T.count('.cm-lp-tsrc')})","save":"tableSource"},
 {"sleep":300},
 {"shot":"it-f2-table-source.png"},
 {"eval":"JSON.stringify({line:T.show('> [!'), callouts:T.count('.cm-lp-co-head')})","save":"callout"},
 {"sleep":400},
 {"shot":"it-f2-callouts.png"},
 {"eval":"(()=>{const v=T.view();v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=0;return 1})()"},
 {"sleep":300},
 {"click":".cm-lp-fm-head"},
 {"sleep":300},
 {"eval":"JSON.stringify({folded:T.count('.cm-lp-fm-folded')})","save":"fmFolded"},
 {"shot":"it-f2-frontmatter-folded.png"},
 {"click":".cm-lp-fm-folded"},
 {"eval":"JSON.stringify(rocksy.docs().map(d=>[d.name,d.dirty]))","save":"docsDirty"}
]}
