 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('const q')+2}});return 1})()"},
 {"shot":"f2-code-active.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=9999;return 1})()"},
 {"sleep":400},
 {"shot":"f3-images.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=0;return 1})()"},
 {"sleep":250},
 {"eval":"JSON.stringify({folded:document.querySelectorAll('.cm-lp-fm-folded').length, head:document.querySelectorAll('.cm-lp-fm-head').length, lines:document.querySelectorAll('.cm-line.cm-lp-fm').length})","save":"fmOpenByDefault"},
 {"click":".cm-lp-fm-head"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});return 1})()"},
 {"sleep":200},
 {"eval":"JSON.stringify({folded:document.querySelectorAll('.cm-lp-fm-folded').length, head:document.querySelectorAll('.cm-lp-fm-head').length, label:(document.querySelector('.cm-lp-fm-folded span')||{}).textContent, preference:localStorage.getItem('rocksy.fmFolded')})","save":"fmFolded"},
 {"shot":"f2-frontmatter-folded.png"},
 {"click":".cm-lp-fm-folded"},
 {"sleep":200},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});return 1})()"},
 {"sleep":200},
 {"eval":"JSON.stringify({folded:document.querySelectorAll('.cm-lp-fm-folded').length, head:document.querySelectorAll('.cm-lp-fm-head').length, lines:document.querySelectorAll('.cm-line.cm-lp-fm').length, dirty:rocksy.activeDoc().dirty, preference:localStorage.getItem('rocksy.fmFolded')})","save":"fmUnfoldedAgain"},
