 {"eval":"(()=>{const was=localStorage.getItem('rocksy.fmFolded');localStorage.setItem('rocksy.fmFolded','0');return was})()","save":"fmFoldedPreferenceBefore"},
 {"nav":"{DIST}?open=00__DEMO/Tableaux%20et%20code.md&fm=open"},
 {"wait":"window.rocksyReady && window.rocksy.tree","timeout":15000},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=0;return 1})()"},
