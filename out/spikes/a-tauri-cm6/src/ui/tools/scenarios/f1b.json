{"steps":[
 {"nav":"{DIST}?open=00__DEMO/Live%20Preview.md"},
 {"wait":"window.rocksyReady && window.rocksy.tree","timeout":15000},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('gras')+2}});v.focus();return 1})()"},
 {"shot":"f1-cursor-in-bold.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('les tableaux')+3}});return 1})()"},
 {"shot":"f1-cursor-in-wikilink.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('## Listes')+1, head:t.indexOf('Deuxième puce')+5}});return 1})()"},
 {"shot":"f1-selection.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=520;return 1})()"},
 {"sleep":200},
 {"shot":"f1-bottom.png"},
 {"click":".cm-lp-check"},
 {"eval":"rocksy.focused.view.state.doc.toString().match(/- \\[.\\] Tâche à faire/)[0]","save":"afterCheckboxClick"},
 {"type":"abc"},
 {"key":"z","mods":"ctrl"},
 {"eval":"rocksy.focused.view.state.doc.toString().slice(-12)","save":"afterTypeUndo"},
 {"key":"f","mods":"ctrl"},
 {"type":"puce"},
 {"shot":"f1-search.png"},
 {"key":"Escape"},
 {"eval":"(()=>{rocksy.focused.view.scrollDOM.scrollTop=0;return 1})()"},
 {"sleep":150},
 {"click":"[data-wikilink='Callouts']"},
 {"wait":"rocksy.activeDoc().name==='Callouts' && rocksy.activeDoc().loaded"},
 {"sleep":300},
 {"shot":"callouts.png"},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('[!tip]')+3}});v.scrollDOM.scrollTop=9999;return 1})()"},
 {"sleep":200},
 {"shot":"callouts-bottom.png"},
 {"click":".cm-lp-fold.is-folded"},
 {"sleep":150},
 {"shot":"callouts-unfolded.png"},
 {"eval":"JSON.stringify(rocksy.docs().map(d=>[d.name,d.dirty]))","save":"tabs"}
]}
