{"steps":[
 {"nav":"{DIST}"},
 {"wait":"window.rocksyReady && window.rocksy.tree && rocksyMock.tagsReady","timeout":30000},
 {"sleep":900},
 {"key":"o","mods":"ctrl"},
 {"wait":"document.querySelector('.picker input')"},
 {"shot":"quickopen-empty.png"},
 {"type":"tabl cod"},
 {"sleep":100},
 {"shot":"quickopen-query.png"},
 {"key":"Enter"},
 {"wait":"rocksy.activeDoc().name==='Tableaux et code' && rocksy.activeDoc().loaded"},
 {"eval":"JSON.stringify(rocksy.focused.tabs.map(d=>d.name))","save":"tabsAfterQuickOpen"},
 {"key":"p","mods":"ctrl"},
 {"wait":"document.querySelector('.picker input')"},
 {"type":"vault"},
 {"shot":"palette.png"},
 {"key":"Escape"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.focus();return 1})()"},
 {"type":"\nVoir [[cal"},
 {"sleep":400},
 {"shot":"complete-wikilink.png"},
 {"key":"Enter"},
 {"type":" et #pro"},
 {"sleep":400},
 {"shot":"complete-tag.png"},
 {"key":"Enter"},
 {"eval":"rocksy.focused.view.state.doc.toString().slice(-40)","save":"afterCompletions"},
 {"eval":"(()=>{rocksyMock.touch(rocksy.activeDoc().path,'# Version externe\\n\\nTexte venu d\\'une autre machine.\\n');return rocksy.activeDoc().conflict})()","save":"conflictKind"},
 {"sleep":200},
 {"shot":"conflict-banner.png"},
 {"key":"s","mods":"ctrl"},
 {"eval":"JSON.stringify({saves:rocksyMock.saves.length, toast:document.querySelector('.st-toast').textContent})","save":"saveDuringConflict"},
 {"click":".banner button[data-act='overwrite']"},
 {"sleep":200},
 {"eval":"JSON.stringify({conflict:rocksy.activeDoc().conflict, dirty:rocksy.activeDoc().dirty, last:rocksyMock.saves[rocksyMock.saves.length-1]})","save":"afterOverwrite"},
 {"eval":"(()=>{rocksyMock.touch(rocksy.activeDoc().path,'# Rechargé\\n\\nContenu externe sur onglet propre.\\n');return 1})()"},
 {"sleep":300},
 {"eval":"JSON.stringify({text:rocksy.focused.view.state.doc.toString(), dirty:rocksy.activeDoc().dirty, toast:document.querySelector('.st-toast').textContent})","save":"afterExternalOnClean"},
 {"type":"x"},
 {"eval":"(()=>{rocksyMock.touch(rocksy.activeDoc().path,'# Encore\\n');return 1})()"},
 {"sleep":150},
 {"click":".banner button[data-act='reload']"},
 {"sleep":250},
 {"eval":"JSON.stringify({text:rocksy.focused.view.state.doc.toString(), dirty:rocksy.activeDoc().dirty, conflict:rocksy.activeDoc().conflict})","save":"afterReload"},
 {"eval":"(()=>{rocksyMock.emit('open-files',{paths:[rocksyMock.outside]});return 1})()"},
 {"wait":"rocksy.activeDoc().name==='hors-vault' && rocksy.activeDoc().loaded"},
 {"sleep":400},
 {"shot":"open-files-outside-tab.png"},
 {"eval":"JSON.stringify(rocksyMock.sessions[rocksyMock.sessions.length-1])","save":"lastSession"},
 {"click":".tab:nth-child(2)","button":"middle"},
 {"sleep":200},
 {"eval":"JSON.stringify(rocksy.focused.tabs.map(d=>d.name))","save":"tabsAfterMiddleClick"},
 {"click":".tab:nth-child(1)"},
 {"wait":"rocksy.activeDoc().name==='__DAILY NOTES DEMO'"},
 {"key":"\\","mods":"ctrl"},
 {"sleep":500},
 {"shot":"split.png"},
 {"eval":"JSON.stringify(rocksy.panes.map(p=>p.tabs.map(d=>d.name)))","save":"panes"},
 {"click":"#rb-vault"},
 {"wait":"document.querySelector('.picker input')"},
 {"shot":"vault-picker.png"},
 {"type":"ajouter"},
 {"key":"Enter"},
 {"wait":"rocksy.vaultRoot==='D:\\\\Vaults\\\\Second' && rocksy.tree","timeout":8000},
 {"sleep":500},
 {"shot":"vault-added.png"},
 {"eval":"JSON.stringify({calls:rocksyMock.calls.filter(c=>/vault|pick/.test(c)), vaults:rocksy.vaults, outside:rocksy.docs().map(d=>[d.name,d.outside])})","save":"vaultAdd"}
]}
