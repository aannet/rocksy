{
 "app": {
  "dataDir": "{IT}\\data-upgrade",
  "args": [],
  "fresh": false
 },
 "steps": [
  {
   "wait": "window.rocksyReady",
   "timeout": 20000
  },
  {
   "evalfile": "helpers.js"
  },
  {
   "wait": "rocksy.vaultRoot && rocksy.indexEvents.some(e=>e.searchReady)",
   "timeout": 60000,
   "save": "B_index_wait_ms"
  },
  {
   "sleep": 1500
  },
  {
   "eval": "JSON.stringify((()=>{const d=rocksy.activeDoc(),v=rocksy.focused.view;return {version:rocksy.info.version,vault:rocksy.vaultRoot&&rocksy.vaultRoot.split('\\\\').pop(),tabs:rocksy.focused.tabs.map(x=>x.name),active:d&&d.name,loaded:d&&d.loaded,line5:v&&v.state.doc.lines>=5?v.state.doc.line(5).text:null,dirty:d&&d.dirty,status:document.getElementById('statusbar').textContent.slice(0,200),index:rocksy.indexEvents.map(e=>({fromCache:!!e.fromCache,searchReady:!!e.searchReady,files:e.files}))}})())",
   "save": "B_state_022"
  },
  {
   "eval": "(async()=>{await rocksy.showSidebar('search');const i=document.querySelector('.search-panel input');i.focus();i.value='quartzline';i.dispatchEvent(new Event('input',{bubbles:true}));const ms=await T.wait(()=>document.querySelector('.search-panel .sr-match'),8000);return JSON.stringify({ms,rows:[...document.querySelectorAll('.search-panel .sr-file')].map(e=>e.textContent.slice(0,40))})})()",
   "save": "B_search"
  },
  {
   "eval": "(async()=>{await T.open(T.vault('Self.md'));T.lineEnd(5);return 1})()"
  },
  {
   "type": " VVV",
   "delay": 40
  },
  {
   "sleep": 300
  },
  {
   "click": ".tab.is-active .tab-name"
  },
  {
   "sleep": 3200
  },
  {
   "eval": "JSON.stringify((()=>{const d=rocksy.activeDoc(),v=rocksy.focused.view;return {version:rocksy.info.version,vault:rocksy.vaultRoot&&rocksy.vaultRoot.split('\\\\').pop(),tabs:rocksy.focused.tabs.map(x=>x.name),active:d&&d.name,loaded:d&&d.loaded,line5:v&&v.state.doc.lines>=5?v.state.doc.line(5).text:null,dirty:d&&d.dirty,status:document.getElementById('statusbar').textContent.slice(0,200),index:rocksy.indexEvents.map(e=>({fromCache:!!e.fromCache,searchReady:!!e.searchReady,files:e.files}))}})())",
   "save": "B_state_after_edit"
  },
  {
   "eval": "(async()=>(await T.inv('read_file',{path:T.vault('Self.md')})).text)()",
   "save": "B_disk_022"
  },
  {
   "py": "listdir",
   "path": "{IT}\\data-upgrade",
   "save": "B_datadir"
  },
  {
   "py": "close",
   "save": "closed"
  }
 ]
}
