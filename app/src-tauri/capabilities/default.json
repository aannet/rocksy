{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the page listens to backend events and calls the app's own commands, nothing else",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-startup-info",
    "allow-read-file",
    "allow-save-file",
    "allow-list-vaults",
    "allow-add-vault",
    "allow-remove-vault",
    "allow-open-vault",
    "allow-close-vault",
    "allow-build-tags",
    "allow-tags-list",
    "allow-tag-fragments",
    "allow-file-tags",
    "allow-search",
    "allow-backlinks",
    "allow-outgoing-links",
    "allow-unresolved-links",
    "allow-set-session",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-log-timing",
    "allow-open-external",
    "allow-close-ack",
    "allow-quit"
  ]
}
