 {"wait":"document.querySelector('.cm-lp-mermaid-body svg')","timeout":10000},
 {"sleep":500},
 {"shot":"mermaid.png"},
 {"eval":"JSON.stringify({svgs:document.querySelectorAll('.cm-lp-mermaid-body svg').length, errors:[...document.querySelectorAll('.cm-lp-mermaid-body.is-error')].map(e=>e.textContent.slice(0,120)), requests: performance.getEntriesByType('resource').map(r=>r.name.replace(/.*\\//,'')).filter(n=>!/^(index|dist|sidebar|mock|extras|tagtree)-/.test(n))})","save":"mermaid"},
