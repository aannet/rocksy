{"steps":[
 {"nav":"{DIST}?open=00__DEMO/Tableaux%20et%20code.md"},
 {"wait":"window.rocksyReady && window.rocksy.tree","timeout":15000},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();v.dispatch({selection:{anchor:t.indexOf('## Tableau')+3}});v.focus();return 1})()"},
 {"key":"ArrowDown","times":2},
 {"eval":"(()=>{const s=rocksy.focused.view.state;return JSON.stringify({line:s.doc.lineAt(s.selection.main.head).text, tableWidgets:document.querySelectorAll('.cm-lp-table').length})})()","save":"arrowDownIntoTable"},
 {"key":"ArrowDown","times":5},
 {"eval":"(()=>{const s=rocksy.focused.view.state;return JSON.stringify({line:s.doc.lineAt(s.selection.main.head).text, tableWidgets:document.querySelectorAll('.cm-lp-table').length})})()","save":"arrowDownOutOfTable"},
 {"key":"ArrowUp","times":2},
 {"eval":"(()=>{const s=rocksy.focused.view.state;return JSON.stringify({line:s.doc.lineAt(s.selection.main.head).text, tableWidgets:document.querySelectorAll('.cm-lp-table').length})})()","save":"arrowUpIntoTable"},
 {"nav":"{DIST}?open=00__DEMO/Live%20Preview.md"},
 {"wait":"window.rocksyReady && window.rocksy.tree","timeout":15000},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();const p=t.indexOf('Troisième niveau')+16;v.dispatch({selection:{anchor:p}});v.focus();return 1})()"},
 {"type":"\nsuite\n\n"},
 {"eval":"(()=>{const t=rocksy.focused.view.state.doc.toString();const i=t.indexOf('Troisième niveau');return JSON.stringify(t.slice(i, i+50))})()","save":"listContinuation"},
 {"eval":"(()=>{const v=rocksy.focused.view;const t=v.state.doc.toString();const p=t.indexOf('- [ ] Tâche à faire #todo')+25;v.dispatch({selection:{anchor:p}});return 1})()"},
 {"type":"\nnouvelle"},
 {"key":"b","mods":"ctrl"},
 {"type":"gras"},
 {"eval":"(()=>{const t=rocksy.focused.view.state.doc.toString();const i=t.indexOf('- [ ] nouvelle');return JSON.stringify(t.slice(i, i+26))})()","save":"taskContinuationAndBold"},
 {"key":"s","mods":"ctrl"},
 {"sleep":150},
 {"eval":"JSON.stringify({saves:rocksyMock.saves.length, dirty:rocksy.activeDoc().dirty, state:document.querySelector('.st-save').textContent})","save":"ctrlS"},
 {"eval":"(()=>{const v=rocksy.focused.view;v.dispatch({selection:{anchor:v.state.doc.length}});v.scrollDOM.scrollTop=0;return 1})()"},
 {"sleep":200},
 {"click":"[data-tag='demo/apercu']","mods":"ctrl"},
 {"wait":"rocksy.sidebar && rocksy.sidebar.tab==='tags' && document.querySelector('.frag')","timeout":8000},
 {"eval":"JSON.stringify({sel:rocksy.sidebar.selectedTag, frags:rocksy.sidebar.fragments.length})","save":"ctrlClickTag"},
 {"click":"[data-wikilink='Callouts#Repliables']"},
 {"wait":"rocksy.activeDoc().name==='Callouts' && document.querySelector('.cm-lp-flash')","timeout":8000},
 {"shot":"heading-link.png","settle":200},
 {"eval":"(()=>{const s=rocksy.focused.view.state;return s.doc.lineAt(s.selection.main.head).text})()","save":"headingLinkLine"},
 {"eval":"(()=>{rocksy.runCommand('tab.close');return 1})()"},
 {"sleep":200},
 {"eval":"JSON.stringify(rocksy.docs().map(d=>d.name))","save":"afterCtrlW"},
 {"eval":"(()=>{rocksy.toggleAutosave();const v=rocksy.focused.view;v.focus();return rocksy.autosave})()","save":"autosaveOff"},
 {"type":"zz"},
 {"sleep":2600},
 {"eval":"JSON.stringify({saves:rocksyMock.saves.length, dirty:rocksy.activeDoc().dirty})","save":"noAutosaveWhenOff"},
 {"eval":"(()=>{rocksy.toggleAutosave();return 1})()"}
]}
